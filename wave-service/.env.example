# Скопируйте в .env и заполните. Без NAVIDROME_URL сервис стартует в демо-режиме.

NAVIDROME_URL=http://192.168.1.50:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Тот же адрес и API_TOKEN, что указаны в плагине AudioMuse в Navidrome
AUDIOMUSE_URL=http://192.168.1.50:8000
AUDIOMUSE_TOKEN=
# или вместо токена — логин и пароль веб-интерфейса AudioMuse
AUDIOMUSE_USER=
AUDIOMUSE_PASSWORD=

# 127.0.0.1 — только этот компьютер; 0.0.0.0 — доступ с телефона в домашней сети
# (в прототипе нет авторизации, не открывайте порт в интернет)
VOLNA_HOST=127.0.0.1
VOLNA_PORT=8765
# VOLNA_DB=data/volna.db
